{
  "description": "figma-mcp: keep the tool folder clean while working on other projects",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/guard.mjs\" 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
